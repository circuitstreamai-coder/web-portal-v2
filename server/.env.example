# Legacy Fastify rollback environment. New deployments use supabase/.env.example.
# Runtime
NODE_ENV=development
PORT=4000
SEED_ON_STARTUP=false

# Public application URLs
# CORS_ORIGIN accepts a comma-separated list of frontend origins.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:4000

# Authentication (replace with a long, random value outside local development)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innoserve
# Optional direct/non-pooled URL used only by database migrations.
DATABASE_URL_DIRECT=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Optional category UUID assigned to tickets created from inbound email.
DEFAULT_EMAIL_CATEGORY_ID=

# Email (configure Resend, SMTP, or both; Resend is attempted first)
RESEND_API_KEY=
SMTP_FROM=Innoserve <noreply@innoserve.in>
SMTP_HOST=smtp.gmail.com
SMTP_SERVERNAME=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
