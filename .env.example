# ── Supabase (current backend) ────────────────────────────────────────────
# Browser-safe values belong in client/.env. Server-only values are configured
# with `supabase secrets set`; see supabase/.env.example.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=never-expose-this-to-the-browser
RESEND_API_KEY=your-resend-api-key
SMTP_FROM=Innoserve <noreply@your-verified-domain.example>
FRONTEND_URL=http://localhost:5173
VERIFICATION_SECRET=generate-a-long-random-secret
BOOTSTRAP_SECRET=generate-a-different-long-random-secret
INBOUND_EMAIL_SECRET=generate-an-inbound-webhook-secret
DEFAULT_EMAIL_CATEGORY_ID=

# ── Legacy Docker/Fastify rollback stack ──────────────────────────────────
# The values below are only used by docker-compose.yml and server/.
# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=innoserve
POSTGRES_PASSWORD=changeme
POSTGRES_DB=innoserve_tms

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=changeme_minio
MINIO_BUCKET=innoserve-files

# ── API ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_to_something_secure_in_production

# ── Web Portal ─────────────────────────────────────────────────────────────
PUBLIC_API_BASE=http://api:3000
