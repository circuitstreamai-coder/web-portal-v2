# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected on the hosted platform
# and cannot be set as secrets; keep them only for `supabase functions serve`.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
VERIFICATION_SECRET=generate-a-long-random-secret
BOOTSTRAP_SECRET=generate-a-different-long-random-secret
INBOUND_EMAIL_SECRET=generate-an-inbound-webhook-secret
DEFAULT_EMAIL_CATEGORY_ID=category-id-for-email-tickets
RESEND_API_KEY=your-resend-api-key
SMTP_FROM=Innoserve <noreply@your-verified-domain.example>
FRONTEND_URL=http://localhost:5173
