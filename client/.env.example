# Supabase browser configuration. The anon key is public and protected by RLS;
# never put SUPABASE_SERVICE_ROLE_KEY in the client environment.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Legacy Fastify fallback during migration. Remove after Supabase cutover.
PRIVATE_API_BASE_URL=http://localhost:4000
